# ── Postgres ──
POSTGRES_USER=context_agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=context_agent
POSTGRES_PORT=5437
POSTGRES_HOST=localhost

# ── Redis ──
REDIS_PORT=6384
REDIS_HOST=localhost

# ── Redis cache (Step 11) ──
CACHE_ENABLED=true
CACHE_SEARCH_TTL_SECONDS=1800
CACHE_RAG_TTL_SECONDS=900
CACHE_SESSION_TTL_SECONDS=3600
CACHE_TRENDING_ENABLED=true
CACHE_TRENDING_TTL_SECONDS=86400

# ── Qdrant ──
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_HOST=localhost

# ── Adminer ──
ADMINER_PORT=8084

# ── App (FastAPI / Alembic) ──
DATABASE_URL=postgresql+asyncpg://context_agent:changeme@localhost:5437/context_agent
REDIS_URL=redis://localhost:6384/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=news_chunks

# ── Vertex AI (embeddings + future LLM) ──
GCP_PROJECT=healthcare-mf
GCP_LOCATION=global
# Auth: run `gcloud auth application-default login`
# Or point to a service account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ── Hybrid search ──
HYBRID_SEMANTIC_LIMIT=20
HYBRID_BM25_LIMIT=20
HYBRID_RESULT_LIMIT=6
RRF_K=60

# ── Reranker (Step 9) ──
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_LIMIT=20

# ── LLM (Vertex AI generation) ──
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_OUTPUT_TOKENS=1024

# ── Speech-to-text (Step 13, Vertex AI / Gemini) ──
STT_ENABLED=true
STT_MODEL=
STT_MAX_AUDIO_BYTES=10485760
STT_MAX_OUTPUT_TOKENS=1024

# ── Web fallback (Tavily, Step 12) ──
TAVILY_API_KEY=
WEB_FALLBACK_ENABLED=true
WEB_FALLBACK_STALE_HOURS=48
WEB_FALLBACK_MIN_HITS=2
WEB_FALLBACK_MAX_RESULTS=5
WEB_FALLBACK_SEARCH_DEPTH=basic
WEB_FALLBACK_MIN_SEMANTIC_SCORE=0.32
WEB_FALLBACK_CACHE_TTL_SECONDS=900

# ── Ingest / retention scheduler (Step 14, Celery) ──
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
SCHEDULER_ENABLED=true
RETENTION_CRON_HOUR=3
RETENTION_CRON_MINUTE=0

# ── Ingest config ──
ARTICLE_RETENTION_DAYS=30
INGEST_INTERVAL_HOURS=6

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Admin (created on first startup if no super_admin exists) ──
ADMIN_EMAIL=admin@contextagent.local
ADMIN_PASSWORD=change-me-strong-password
ADMIN_API_KEY=change-me-long-random-api-key

# ── JWT ──
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
